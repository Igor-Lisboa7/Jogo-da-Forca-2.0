   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Halloween background with graveyard. Cemetery with tombstones by day. Summer landscape of forest with old gravestones, gates, green trees and grass, vector cartoon illustration</rdf:li>
