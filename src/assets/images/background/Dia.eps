   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cemetery, graveyard with tombstones and trees</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cemetery, graveyard with tombstones in forest with trees around, cracked crosses, monuments with rip signature. Old grave tombs on green field with grass at day time. Cartoon vector illustration</rdf:li>
    </rdf:Alt>
   </dc:description>
